# ---------------------------------------------------------------
# PolyglotMesh — repository-wide ignore rules
# ---------------------------------------------------------------

# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key
application-local.properties
application-local.yml

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------------------------------------------------------------
# Java / Maven / backend
# ---------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
.mvn/timing.properties
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------------------------------------------------------------
# IDE and editor files
# ---------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.project
.classpath
.settings/
.factorypath
*.sublime-workspace

# ---------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------
logs/
*.log
tmp/
temp/
